# bio-waila secrets and local settings.
#   cp .env.example .env && chmod 600 .env     then fill in the values below.
# .env is gitignored; this example file is the only one committed. Values already set in the shell win over .env.

# Hugging Face: raises download rate limits and is required for gated checkpoints (Gemma etc.).
# Create at https://huggingface.co/settings/tokens (read access is enough).
HF_TOKEN=

# Kaggle API token (starts with KGAT_). Create at https://www.kaggle.com/settings -> API -> "Generate New Token".
# Used for the ~26 Kaggle-hosted datasets. (Legacy fallback: KAGGLE_USERNAME + KAGGLE_KEY, or ~/.kaggle/ files.)
KAGGLE_API_TOKEN=
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional path overrides (defaults live in src/bio_waila/paths.py and slurm/env.sh).
# WAILA_DATA=
# WAILA_PUBLIC=
# WAILA_REGISTRY=
